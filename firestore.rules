rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() { return request.auth != null && request.auth.token.email == 'admin@osm.local'; }
    function isStaff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'staff';
    }
    match /{col}/{doc} {
      allow read: if col in ['meta','players','events'];
      allow write: if isAdmin();
    }
    match /users/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['u','d'])
        && (resource.data.get('role', '') == ''
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role','pid']));
    }
    match /usernames/{n} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && n == request.resource.data.u.lower();
    }
    match /notices/{id} {
      allow read: if true;
      allow write: if isAdmin() || isStaff();
    }
    match /reads/{id} {
      allow read: if isAdmin() || isStaff() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.nid + '_' + request.auth.uid;
      allow delete: if isAdmin() || isStaff();
    }
    match /claims/{pid} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }
    match /drafts/{id} {
      allow read, write: if isAdmin() || isStaff();
    }
    match /live/{id} {
      allow read: if true;
      allow write: if isAdmin() || isStaff();
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vids'])
        && request.resource.data.get('vids', {}).diff(resource.data.get('vids', {})).affectedKeys().hasOnly([request.auth.uid]);
    }
    match /events/{id} {
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stats','lineup','lineupAt']);
    }
    match /cards/{id} {
      allow read: if true;
      allow write: if isAdmin() || isStaff();
    }
    match /inv/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /trades/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid && request.resource.data.status == 'open';
      allow update: if request.auth != null && (resource.data.from == request.auth.uid
        || (resource.data.status == 'open' && request.resource.data.status == 'accepted' && request.resource.data.by == request.auth.uid));
      allow delete: if request.auth != null && (isAdmin() || resource.data.from == request.auth.uid);
    }
    match /motm/{id} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.ym + '_' + request.auth.uid;
    }
    match /mvp/{id} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.eid + '_' + request.auth.uid;
    }
    match /votes/{id} {
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.eid + '_' + request.auth.uid;
    }
  }
}
